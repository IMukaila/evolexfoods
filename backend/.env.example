APP_NAME="Evolex Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Database ──────────────────────────────────────────────────────────────────
# Railway provides these automatically when you add a MySQL plugin.
# You can reference them as ${{MySQL.MYSQL_URL}} in Railway's variable editor.
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your Railway frontend URL after deploying.
FRONTEND_URL=https://your-frontend.up.railway.app
SANCTUM_STATEFUL_DOMAINS=your-frontend.up.railway.app

# ── Mail (optional) ───────────────────────────────────────────────────────────
MAIL_MAILER=log
